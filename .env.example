# Needed for resume tailoring and drafting screening answers (search, filters and ranking work without it)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Folder with your base resumes: resume_data.docx, resume_it.docx, resume_software.docx
# (optionally a .pdf of each with the same name). Defaults to the fake sample in examples/resumes.
# RESUME_DIR=C:\path\to\your\resumes

# Optional: city to put in tailored resume headers
# CANDIDATE_LOCATION=Columbus, OH

# Optional: 1 = show the browser window during logged-in LinkedIn search
# BROWSER_HEADED=0
